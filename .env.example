POSTGRES_USER=kfagent
POSTGRES_PASSWORD=kfagent
POSTGRES_DB=kfagent
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://kfagent:kfagent@localhost:5432/kfagent
SESSION_TTL_SECONDS=604800

# Public URL the browser uses to reach this API (upload URLs point here)
API_PUBLIC_BASE_URL=http://localhost:8000

# Script storage: "fake" (in-memory, lost on restart) or "s3" (SeaweedFS S3 gateway)
SEAWEEDFS_CLIENT=fake
# With the SSH tunnel open (ssh -L 8333:localhost:8333 <user>@<host>), the gateway is at localhost:8333
SEAWEEDFS_S3_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=changeme
SEAWEEDFS_SECRET_KEY=changeme
SEAWEEDFS_BUCKET=kubie-bridge-storage
